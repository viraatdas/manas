# fastlane Fastfile — Manas iOS
#
# CLI-driven TestFlight pipeline. Auth uses an App Store Connect API key from
# the environment (see .asc.env, gitignored):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH, APPLE_TEAM_ID
#
# Lanes:
#   bootstrap  — create the App Store Connect app record (idempotent).
#   beta       — upload the already-exported .ipa (build/Manas.ipa) to TestFlight.
#   tf_status  — processing + compliance state of the latest build.
#
# The archive itself is produced by scripts/ios-testflight.sh with xcodebuild
# automatic cloud signing (the API key registers bundle ids, the app group,
# and profiles on demand), which handles the app + widget extension pair more
# reliably than manual cert/sigh juggling.

default_platform(:ios)

APP_ID    = ENV["APP_IDENTIFIER"] || "dev.viraat.manas.ios"
WIDGET_ID = "#{APP_ID}.widget"

def asc_api_key
  return nil unless ENV["ASC_KEY_ID"] && ENV["ASC_ISSUER_ID"] && ENV["ASC_KEY_PATH"]
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: ENV["ASC_KEY_PATH"],
    in_house: false,
  )
end

platform :ios do
  desc "Create the bundle ids + App Store Connect app record (idempotent)."
  lane :bootstrap do
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], filepath: ENV["ASC_KEY_PATH"]
    )

    # 1) Bundle ids for the app and its widget extension. Capabilities beyond
    # these are registered by Xcode cloud signing at archive time.
    existing = Spaceship::ConnectAPI::BundleId.all(filter: { identifier: APP_ID })
      .map(&:identifier)
    [[APP_ID, "Manas iOS"], [WIDGET_ID, "Manas iOS Widget"]].each do |identifier, name|
      if Spaceship::ConnectAPI::BundleId.all(filter: { identifier: identifier })
          .any? { |b| b.identifier == identifier }
        UI.message("bundle id #{identifier} exists")
      else
        Spaceship::ConnectAPI::BundleId.create(name: name, identifier: identifier, platform: "IOS")
        UI.success("created bundle id #{identifier}")
      end
    end

    # 2) The app record itself.
    if (app = Spaceship::ConnectAPI::App.find(APP_ID))
      UI.success("app record exists: #{app.name} (#{app.id})")
    else
      name = ENV["MANAS_APP_NAME"] || "Manas"
      app = Spaceship::ConnectAPI::App.create(
        name: name,
        version_string: "1.0",
        sku: "manas-ios-viraat",
        primary_locale: "en-US",
        bundle_id: APP_ID,
        platforms: ["IOS"],
        company_name: nil
      )
      UI.success("created app record: #{name} (#{app.id})")
    end
  end

  # Raw App Store Connect REST call with the API-key JWT.
  def asc_raw(method, path, body = nil)
    require "net/http"; require "json"; require "uri"
    require "spaceship"
    Spaceship::ConnectAPI.token ||= Spaceship::ConnectAPI::Token.create(
      key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], filepath: ENV["ASC_KEY_PATH"]
    )
    jwt = Spaceship::ConnectAPI.token.text
    uri = URI("https://api.appstoreconnect.apple.com/#{path}")
    klass = { get: Net::HTTP::Get, post: Net::HTTP::Post, patch: Net::HTTP::Patch,
              delete: Net::HTTP::Delete }[method]
    req = klass.new(uri)
    req["Authorization"] = "Bearer #{jwt}"
    req["Content-Type"] = "application/json"
    req.body = body.to_json if body
    http = Net::HTTP.new(uri.host, uri.port); http.use_ssl = true
    res = http.request(req)
    parsed = (JSON.parse(res.body) rescue res.body)
    [res.code.to_i, parsed]
  end

  desc "Probe App Group support in the public ASC API."
  lane :probe_app_groups do
    [
      "v1/appGroups?limit=5",
      "v1/bundleIds?filter%5Bidentifier%5D=dev.viraat.manas.ios&include=bundleIdCapabilities",
    ].each do |path|
      code, resp = asc_raw(:get, path)
      UI.message "GET #{path.split('?').first} -> #{code}: #{resp.inspect[0, 300]}"
    end
  end

  desc "Create the app record via the Apple ID web session (apps can't be created with a team API key)."
  lane :bootstrap_app do
    require "spaceship"
    Spaceship::ConnectAPI.login(
      ENV["FASTLANE_APPLE_ID"] || "viraat.laldas@gmail.com", nil,
      use_portal: false, use_tunes: true
    )
    if (app = Spaceship::ConnectAPI::App.find(APP_ID))
      UI.success("app record exists: #{app.name} (#{app.id})")
    else
      name = ENV["MANAS_APP_NAME"] || "Manas"
      app = Spaceship::ConnectAPI::App.create(
        name: name,
        version_string: "1.0",
        sku: "manas-ios-viraat",
        primary_locale: "en-US",
        bundle_id: APP_ID,
        platforms: ["IOS"],
        company_name: nil
      )
      UI.success("created app record: #{name} (#{app.id})")
    end
  end

  desc "Fetch/create the Distribution cert + App Store profiles for app and widget."
  lane :prep_signing do
    key = asc_api_key
    UI.user_error!("ASC API key not configured") unless key
    cert(api_key: key, generate_apple_certs: true, output_path: "build/certs")
    sigh(
      api_key: key,
      app_identifier: APP_ID,
      platform: "ios",
      force: true,
      output_path: "build/profiles",
    )
    sigh(
      api_key: key,
      app_identifier: WIDGET_ID,
      platform: "ios",
      force: true,
      output_path: "build/profiles",
    )
  end

  desc "Upload build/Manas.ipa to TestFlight."
  lane :beta do
    key = asc_api_key
    UI.user_error!("ASC API key not configured") unless key
    upload_to_testflight(
      api_key: key,
      app_identifier: APP_ID,
      ipa: "build/Manas.ipa",
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Wait for the latest build to process, clear compliance, and put it in an internal group."
  lane :tf_internal do
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], filepath: ENV["ASC_KEY_PATH"]
    )
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.user_error!("App #{APP_ID} not found") unless app

    expected_build = ENV["TF_BUILD_NUMBER"]
    build = nil
    40.times do |i|
      candidates = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 20)
      build = if expected_build
        candidates.find { |candidate| candidate.version == expected_build }
      else
        candidates.first
      end
      state = build&.processing_state
      label = expected_build || "latest"
      UI.message("[#{i}] build #{label}: #{build&.version || 'not visible'} state=#{state || 'none yet'}")
      break if state == "VALID"
      sleep(15)
    end
    UI.user_error!("Build #{expected_build || 'latest'} did not become VALID") unless build&.processing_state == "VALID"

    begin
      build.update(attributes: { usesNonExemptEncryption: false })
      UI.success("Export compliance cleared")
    rescue => e
      UI.message("Compliance note: #{e.message}")
    end

    code, body = asc_raw(:get, "v1/betaGroups?filter%5Bapp%5D=#{app.id}&limit=50")
    groups = (body["data"] || [])
    group = groups.find { |g| g.dig("attributes", "isInternalGroup") } || groups.first
    if group.nil?
      # A fresh app has no groups; create the internal one.
      code, created = asc_raw(:post, "v1/betaGroups", {
        data: { type: "betaGroups",
                attributes: { name: "Internal", isInternalGroup: true, hasAccessToAllBuilds: true },
                relationships: { app: { data: { type: "apps", id: app.id } } } } })
      if (200..299).include?(code)
        group = created["data"]
        UI.success("Created internal beta group")
      else
        UI.important("Could not create internal group (#{code}): #{created.inspect[0, 200]}")
      end
    end
    if group && !group.dig("attributes", "hasAccessToAllBuilds")
      ac, ab = asc_raw(:post, "v1/betaGroups/#{group["id"]}/relationships/builds",
                       { data: [{ type: "builds", id: build.id }] })
      if (200..299).include?(ac) || ac == 409
        UI.success("Build #{build.version} in group '#{group.dig("attributes", "name")}'")
      else
        UI.important("Attach build -> #{ac}: #{ab.inspect[0, 200]}")
      end
    elsif group
      UI.success("Group '#{group.dig("attributes", "name")}' already has access to all builds")
    end
    UI.success("Internal TestFlight ready: install from the TestFlight app with the account-holder Apple ID.")
  end

  desc "Set the App Store Connect app name. Set MANAS_RENAME."
  lane :asc_rename do
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], filepath: ENV["ASC_KEY_PATH"]
    )
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.user_error!("App #{APP_ID} not found") unless app
    new_name = ENV["MANAS_RENAME"] || UI.user_error!("set MANAS_RENAME")
    info = app.fetch_edit_app_info || app.fetch_live_app_info
    UI.user_error!("no editable app info") unless info
    locs = info.get_app_info_localizations
    loc = locs.find { |l| l.locale == "en-US" } || locs.first
    UI.message("current name: #{loc.name.inspect}")
    loc.update(attributes: { name: new_name })
    UI.success("name set to #{new_name.inspect}")
  end

  desc "Add the account holder as an internal tester."
  lane :tf_add_tester do
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], filepath: ENV["ASC_KEY_PATH"]
    )
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    code, body = asc_raw(:get, "v1/betaGroups?filter%5Bapp%5D=#{app.id}&limit=50")
    group = (body["data"] || []).find { |g| g.dig("attributes", "isInternalGroup") }
    UI.user_error!("no internal group") unless group
    email = ENV["TF_EMAIL"] || "viraat.laldas@gmail.com"
    tc, tb = asc_raw(:post, "v1/betaTesters", {
      data: { type: "betaTesters",
              attributes: { email: email, firstName: "Viraat", lastName: "Das" },
              relationships: { betaGroups: { data: [{ type: "betaGroups", id: group["id"] }] } } } })
    UI.message("add tester #{email} -> #{tc}: #{tb.inspect[0, 160]}")
    gc, gb = asc_raw(:get, "v1/betaGroups/#{group["id"]}/betaTesters?limit=20")
    (gb["data"] || []).each { |t| UI.success("tester: #{t.dig("attributes", "email")} (#{t.dig("attributes", "state")})") }
  end

  desc "Create the external group and invite the requested testers."
  lane :tf_invite_external do
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], filepath: ENV["ASC_KEY_PATH"]
    )
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.user_error!("App #{APP_ID} not found") unless app

    groups_code, body = asc_raw(:get, "v1/betaGroups?limit=200")
    UI.user_error!("Group lookup failed (#{groups_code}): #{body.inspect}") unless (200..299).include?(groups_code)
    group = (body["data"] || []).find do |candidate|
      candidate.dig("relationships", "app", "data", "id") == app.id &&
        !candidate.dig("attributes", "isInternalGroup") &&
        candidate.dig("attributes", "name") == "External Testers"
    end
    unless group
      code, created = asc_raw(:post, "v1/betaGroups", {
        data: {
          type: "betaGroups",
          attributes: {
            name: "External Testers",
            isInternalGroup: false,
            hasAccessToAllBuilds: false,
            publicLinkEnabled: false,
          },
          relationships: { app: { data: { type: "apps", id: app.id } } },
        },
      })
      UI.user_error!("Create external group failed (#{code}): #{created.inspect}") unless (200..299).include?(code)
      group = created["data"]
      UI.success("Created external TestFlight group")
    end

    testers = [
      ["nikitaaggarwal777@gmail.com", "Nikita", "Aggarwal"],
      ["vaageesha.das@gmail.com", "Vaageesha", "Das"],
      ["itsme@krithikrao.com", "Krithik", "Rao"],
      ["dark.luck4777@krithikrao.com", "Krithik", "Rao"],
    ]
    _, existing_body = asc_raw(:get, "v1/betaGroups/#{group["id"]}/betaTesters?limit=200")
    existing = (existing_body["data"] || []).map { |tester| tester.dig("attributes", "email").downcase }
    testers.each do |email, first_name, last_name|
      if existing.include?(email.downcase)
        UI.message("#{email} is already in External Testers")
        next
      end
      code, response = asc_raw(:post, "v1/betaTesters", {
        data: {
          type: "betaTesters",
          attributes: { email: email, firstName: first_name, lastName: last_name },
          relationships: {
            betaGroups: { data: [{ type: "betaGroups", id: group["id"] }] },
          },
        },
      })
      UI.user_error!("Invite #{email} failed (#{code}): #{response.inspect}") unless (200..299).include?(code)
      UI.success("Added #{email} to External Testers")
    end
  end

  desc "Upload App Store listing metadata and screenshots without submitting."
  lane :store_metadata do
    key = asc_api_key
    UI.user_error!("ASC API key not configured") unless key
    screenshots_path = ENV["STORE_SCREENSHOTS_PATH"]
    UI.user_error!("Set STORE_SCREENSHOTS_PATH") if screenshots_path.to_s.empty?
    screenshots_only = ENV["STORE_SCREENSHOTS_ONLY"] == "1"
    review_phone = ENV["ASC_REVIEW_PHONE"]
    review_information = if review_phone.to_s.empty?
      nil
    else
      {
        first_name: "Viraat",
        last_name: "Das",
        phone_number: review_phone,
        email_address: "viraat.laldas@gmail.com",
        demo_user: "+1 555 555 0100",
        demo_password: "123456",
        notes: File.read(File.expand_path("metadata/review_information/notes.txt", __dir__)),
      }
    end
    upload_to_app_store(
      api_key: key,
      app_identifier: APP_ID,
      app_version: "1.0",
      metadata_path: "fastlane/metadata",
      screenshots_path: screenshots_path,
      skip_binary_upload: true,
      skip_metadata: screenshots_only,
      skip_screenshots: false,
      overwrite_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false,
      app_review_information: review_information,
    )
  end

  desc "Attach a processed build to App Store 1.0 and prepare external TestFlight."
  lane :prepare_review_build do
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], filepath: ENV["ASC_KEY_PATH"]
    )
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.user_error!("App #{APP_ID} not found") unless app
    build_number = ENV["TF_BUILD_NUMBER"] || UI.user_error!("Set TF_BUILD_NUMBER")
    build = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 20)
      .find { |candidate| candidate.version == build_number }
    UI.user_error!("Build #{build_number} not found") unless build
    UI.user_error!("Build #{build_number} is #{build.processing_state}") unless build.processing_state == "VALID"

    _, versions_body = asc_raw(
      :get,
      "v1/apps/#{app.id}/appStoreVersions?filter%5Bplatform%5D=IOS&filter%5BversionString%5D=1.0&limit=1"
    )
    version = (versions_body["data"] || []).first
    UI.user_error!("App Store version 1.0 not found") unless version
    code, response = asc_raw(
      :patch,
      "v1/appStoreVersions/#{version["id"]}/relationships/build",
      { data: { type: "builds", id: build.id } }
    )
    UI.user_error!("Attach App Store build failed (#{code}): #{response.inspect}") unless (200..299).include?(code)
    UI.success("Attached build #{build_number} to App Store version 1.0")

    _, groups_body = asc_raw(:get, "v1/betaGroups?filter%5Bapp%5D=#{app.id}&limit=50")
    group = (groups_body["data"] || []).find do |candidate|
      !candidate.dig("attributes", "isInternalGroup") &&
        candidate.dig("attributes", "name") == "External Testers"
    end
    UI.user_error!("External Testers group not found") unless group

    _, localizations_body = asc_raw(:get, "v1/builds/#{build.id}/betaBuildLocalizations?limit=20")
    localization = (localizations_body["data"] || []).find do |candidate|
      candidate.dig("attributes", "locale") == "en-US"
    end
    attributes = {
      whatsNew: "Plan your day in a continuous feed, organize todos into groups, sync securely with Mac, and review evidence-backed progress.",
    }
    if localization
      code, response = asc_raw(
        :patch,
        "v1/betaBuildLocalizations/#{localization["id"]}",
        { data: { type: "betaBuildLocalizations", id: localization["id"], attributes: attributes } }
      )
    else
      code, response = asc_raw(:post, "v1/betaBuildLocalizations", {
        data: {
          type: "betaBuildLocalizations",
          attributes: attributes.merge(locale: "en-US"),
          relationships: { build: { data: { type: "builds", id: build.id } } },
        },
      })
    end
    UI.user_error!("Beta build notes failed (#{code}): #{response.inspect}") unless (200..299).include?(code)

    code, response = asc_raw(
      :post,
      "v1/betaGroups/#{group["id"]}/relationships/builds",
      { data: [{ type: "builds", id: build.id }] }
    )
    unless (200..299).include?(code) || code == 409
      UI.user_error!("Attach external TestFlight build failed (#{code}): #{response.inspect}")
    end
    UI.success("Attached build #{build_number} to External Testers")
  end

  desc "Declare no third-party content and a 4+ App Store age rating."
  lane :store_compliance do
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], filepath: ENV["ASC_KEY_PATH"]
    )
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.user_error!("App #{APP_ID} not found") unless app

    code, response = asc_raw(:patch, "v1/apps/#{app.id}", {
      data: {
        type: "apps",
        id: app.id,
        attributes: { contentRightsDeclaration: "DOES_NOT_USE_THIRD_PARTY_CONTENT" },
      },
    })
    UI.user_error!("Content-rights update failed (#{code}): #{response.inspect}") unless (200..299).include?(code)

    app_info = app.fetch_edit_app_info || app.fetch_live_app_info
    UI.user_error!("No editable app info") unless app_info
    declaration = app_info.fetch_age_rating_declaration
    UI.user_error!("No age-rating declaration") unless declaration
    rating_attributes = {
      alcoholTobaccoOrDrugUseOrReferences: "NONE",
      contests: "NONE",
      gamblingSimulated: "NONE",
      gunsOrOtherWeapons: "NONE",
      horrorOrFearThemes: "NONE",
      matureOrSuggestiveThemes: "NONE",
      medicalOrTreatmentInformation: "NONE",
      profanityOrCrudeHumor: "NONE",
      sexualContentGraphicAndNudity: "NONE",
      sexualContentOrNudity: "NONE",
      violenceCartoonOrFantasy: "NONE",
      violenceRealisticProlongedGraphicOrSadistic: "NONE",
      violenceRealistic: "NONE",
      advertising: false,
      ageAssurance: false,
      gambling: false,
      healthOrWellnessTopics: false,
      lootBox: false,
      messagingAndChat: false,
      parentalControls: false,
      unrestrictedWebAccess: false,
      userGeneratedContent: false,
      ageRatingOverrideV2: "NONE",
      koreaAgeRatingOverride: "NONE",
    }
    code, response = asc_raw(:patch, "v1/ageRatingDeclarations/#{declaration.id}", {
      data: {
        type: "ageRatingDeclarations",
        id: declaration.id,
        attributes: rating_attributes,
      },
    })
    UI.user_error!("Age-rating update failed (#{code}): #{response.inspect}") unless (200..299).include?(code)
    UI.success("Content rights and 4+ age rating configured")
  end

  desc "Declare and publish Manas App Privacy data usage."
  lane :store_privacy do
    require "spaceship"
    Spaceship::ConnectAPI.login(
      ENV["FASTLANE_APPLE_ID"] || "viraat.laldas@gmail.com",
      nil,
      use_portal: false,
      use_tunes: true,
      tunes_team_id: ENV["FASTLANE_ITC_TEAM_ID"] || "118673131",
    )
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.user_error!("App #{APP_ID} not found") unless app

    desired = [
      ["PHONE_NUMBER", "DATA_LINKED_TO_YOU", "APP_FUNCTIONALITY"],
      ["USER_ID", "DATA_LINKED_TO_YOU", "APP_FUNCTIONALITY"],
      ["OTHER_USER_CONTENT", "DATA_LINKED_TO_YOU", "APP_FUNCTIONALITY"],
      ["DEVICE_ID", "DATA_NOT_LINKED_TO_YOU", "ANALYTICS"],
      ["PRODUCT_INTERACTION", "DATA_NOT_LINKED_TO_YOU", "ANALYTICS"],
    ]
    usages = Spaceship::ConnectAPI::AppDataUsage.all(
      app_id: app.id,
      includes: "category,dataProtection,purpose",
    )
    existing = usages.map do |usage|
      [usage.category&.id, usage.data_protection&.id, usage.purpose&.id]
    end
    unexpected = existing.compact - desired
    unless unexpected.empty?
      UI.user_error!("Unexpected existing privacy declarations: #{unexpected.inspect}")
    end

    desired.each do |category, protection, purpose|
      if existing.include?([category, protection, purpose])
        UI.message("Privacy declaration already present: #{category}")
        next
      end
      Spaceship::ConnectAPI::AppDataUsage.create(
        app_id: app.id,
        app_data_usage_category_id: category,
        app_data_usage_protection_id: protection,
        app_data_usage_purpose_id: purpose,
      )
      UI.success("Declared #{category} / #{protection} / #{purpose}")
    end

    state = Spaceship::ConnectAPI::AppDataUsagesPublishState.get(app_id: app.id)
    UI.user_error!("Privacy publish state not found") unless state
    state.publish!
    UI.success("Published App Privacy responses")
  end

  desc "Make Manas free and available in all App Store territories."
  lane :store_pricing do
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], filepath: ENV["ASC_KEY_PATH"]
    )
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.user_error!("App #{APP_ID} not found") unless app

    schedule_code, schedule_body = asc_raw(:get, "v1/apps/#{app.id}/appPriceSchedule")
    active_free_price = false
    if (200..299).include?(schedule_code)
      schedule_id = schedule_body.dig("data", "id")
      if schedule_id
        manual_code, manual_body = asc_raw(
          :get,
          "v1/appPriceSchedules/#{schedule_id}/manualPrices?include=appPricePoint&limit=200"
        )
        UI.user_error!("Manual-price lookup failed (#{manual_code}): #{manual_body.inspect}") unless (200..299).include?(manual_code)
        price_points = (manual_body["included"] || []).to_h do |resource|
          [resource["id"], resource.dig("attributes", "customerPrice")]
        end
        active_free_price = (manual_body["data"] || []).any? do |price|
          point_id = price.dig("relationships", "appPricePoint", "data", "id")
          price.dig("attributes", "endDate").nil? && price_points[point_id].to_f.zero?
        end
      end
    end

    unless active_free_price
      points_code, points_body = asc_raw(
        :get,
        "v1/apps/#{app.id}/appPricePoints?filter%5Bterritory%5D=USA&limit=200"
      )
      UI.user_error!("Price-point lookup failed (#{points_code}): #{points_body.inspect}") unless (200..299).include?(points_code)
      free_point = (points_body["data"] || []).find do |point|
        point.dig("attributes", "customerPrice").to_f.zero?
      end
      UI.user_error!("Free USA price point not found") unless free_point
      price_id = "${newprice-0}"
      code, response = asc_raw(:post, "v1/appPriceSchedules", {
        data: {
          type: "appPriceSchedules",
          attributes: {},
          relationships: {
            app: { data: { type: "apps", id: app.id } },
            baseTerritory: { data: { type: "territories", id: "USA" } },
            manualPrices: { data: [{ type: "appPrices", id: price_id }] },
          },
        },
        included: [{
          type: "appPrices",
          id: price_id,
          attributes: { startDate: nil, endDate: nil },
          relationships: {
            appPricePoint: {
              data: { type: "appPricePoints", id: free_point["id"] },
            },
          },
        }],
      })
      UI.user_error!("Free price schedule failed (#{code}): #{response.inspect}") unless (200..299).include?(code)
      UI.success("Configured free App Store pricing")
    else
      UI.success("Free App Store pricing is already active")
    end

    availability_code, = asc_raw(:get, "v1/apps/#{app.id}/appAvailabilityV2")
    unless (200..299).include?(availability_code)
      territories_code, territories_body = asc_raw(:get, "v1/territories?limit=200")
      UI.user_error!("Territory lookup failed (#{territories_code})") unless (200..299).include?(territories_code)
      territories = territories_body["data"] || []
      linkages = []
      included = territories.each_with_index.map do |territory, index|
        placeholder = "${territoryAvailability-#{index}}"
        linkages << { type: "territoryAvailabilities", id: placeholder }
        {
          type: "territoryAvailabilities",
          id: placeholder,
          attributes: { available: true, preOrderEnabled: false },
          relationships: {
            territory: {
              data: { type: "territories", id: territory["id"] },
            },
          },
        }
      end
      code, response = asc_raw(:post, "v2/appAvailabilities", {
        data: {
          type: "appAvailabilities",
          attributes: { availableInNewTerritories: true },
          relationships: {
            app: { data: { type: "apps", id: app.id } },
            territoryAvailabilities: { data: linkages },
          },
        },
        included: included,
      })
      UI.user_error!("Worldwide availability failed (#{code}): #{response.inspect[0, 1000]}") unless (200..299).include?(code)
      UI.success("Enabled all App Store territories")
    else
      UI.success("App Store availability already exists")
    end
  end

  desc "Complete TestFlight review details and submit the external build for beta review."
  lane :submit_beta_review do
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], filepath: ENV["ASC_KEY_PATH"]
    )
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.user_error!("App #{APP_ID} not found") unless app
    build_number = ENV["TF_BUILD_NUMBER"] || UI.user_error!("Set TF_BUILD_NUMBER")
    phone = ENV["ASC_REVIEW_PHONE"] || UI.user_error!("Set ASC_REVIEW_PHONE with +country code")
    build = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 20)
      .find { |candidate| candidate.version == build_number }
    UI.user_error!("Build #{build_number} not found") unless build

    beta_attributes = {
      contactEmail: "viraat.laldas@gmail.com",
      contactFirstName: "Viraat",
      contactLastName: "Das",
      contactPhone: phone,
      demoAccountName: "+1 555 555 0100",
      demoAccountPassword: "123456",
      demoAccountRequired: true,
      notes: File.read(File.expand_path("metadata/review_information/notes.txt", __dir__)),
    }
    _, details_body = asc_raw(
      :get,
      "v1/betaAppReviewDetails?filter%5Bapp%5D=#{app.id}&limit=1"
    )
    detail = (details_body["data"] || []).first
    UI.user_error!("Beta review detail not found") unless detail
    code, response = asc_raw(:patch, "v1/betaAppReviewDetails/#{detail["id"]}", {
      data: { type: "betaAppReviewDetails", id: detail["id"], attributes: beta_attributes },
    })
    UI.user_error!("Beta review details failed (#{code}): #{response.inspect}") unless (200..299).include?(code)

    _, app_localizations_body = asc_raw(:get, "v1/apps/#{app.id}/betaAppLocalizations?limit=20")
    localization = (app_localizations_body["data"] || []).find do |candidate|
      candidate.dig("attributes", "locale") == "en-US"
    end
    localization_attributes = {
      description: "A focused daily todo planner with secure iPhone–Mac sync and optional evidence-backed progress from local Mac context.",
      feedbackEmail: "viraat.laldas@gmail.com",
      marketingUrl: "https://manas.viraat.dev/",
      privacyPolicyUrl: "https://manas.viraat.dev/privacy/",
    }
    if localization
      code, response = asc_raw(:patch, "v1/betaAppLocalizations/#{localization["id"]}", {
        data: {
          type: "betaAppLocalizations",
          id: localization["id"],
          attributes: localization_attributes,
        },
      })
    else
      code, response = asc_raw(:post, "v1/betaAppLocalizations", {
        data: {
          type: "betaAppLocalizations",
          attributes: localization_attributes.merge(locale: "en-US"),
          relationships: { app: { data: { type: "apps", id: app.id } } },
        },
      })
    end
    UI.user_error!("Beta app localization failed (#{code}): #{response.inspect}") unless (200..299).include?(code)

    code, response = asc_raw(:post, "v1/betaAppReviewSubmissions", {
      data: {
        type: "betaAppReviewSubmissions",
        relationships: { build: { data: { type: "builds", id: build.id } } },
      },
    })
    UI.user_error!("Beta review submission failed (#{code}): #{response.inspect}") unless (200..299).include?(code)
    UI.success("Build #{build_number} submitted for TestFlight beta review")
  end

  desc "Submit App Store version 1.0 build 11 for review."
  lane :submit_app_review do
    key = asc_api_key
    UI.user_error!("ASC API key not configured") unless key
    upload_to_app_store(
      api_key: key,
      app_identifier: APP_ID,
      app_version: "1.0",
      build_number: ENV["TF_BUILD_NUMBER"] || "11",
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false,
      },
    )
  end

  desc "Verify App Store review, TestFlight review, and external tester state."
  lane :release_status do
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], filepath: ENV["ASC_KEY_PATH"]
    )
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.user_error!("App #{APP_ID} not found") unless app

    versions_code, versions_body = asc_raw(
      :get,
      "v1/apps/#{app.id}/appStoreVersions?filter%5Bplatform%5D=IOS&filter%5BversionString%5D=1.0&limit=1"
    )
    UI.user_error!("Version status lookup failed (#{versions_code})") unless (200..299).include?(versions_code)
    version = (versions_body["data"] || []).first
    UI.user_error!("App Store version 1.0 not found") unless version
    UI.success("App Store 1.0 state=#{version.dig("attributes", "appStoreState")}")

    build_number = ENV["TF_BUILD_NUMBER"] || "11"
    build = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 20)
      .find { |candidate| candidate.version == build_number }
    UI.user_error!("Build #{build_number} not found") unless build
    beta_code, beta_body = asc_raw(
      :get,
      "v1/betaAppReviewSubmissions?filter%5Bbuild%5D=#{build.id}&limit=20"
    )
    UI.user_error!("Beta review status lookup failed (#{beta_code})") unless (200..299).include?(beta_code)
    beta_submission = (beta_body["data"] || []).first
    beta_state = beta_submission&.dig("attributes", "betaReviewState") || "NOT_SUBMITTED"
    UI.success("TestFlight build #{build_number} review state=#{beta_state}")

    _, groups_body = asc_raw(:get, "v1/betaGroups?filter%5Bapp%5D=#{app.id}&limit=50")
    group = (groups_body["data"] || []).find do |candidate|
      !candidate.dig("attributes", "isInternalGroup") &&
        candidate.dig("attributes", "name") == "External Testers"
    end
    UI.user_error!("External Testers group not found") unless group
    testers_code, testers_body = asc_raw(
      :get,
      "v1/betaGroups/#{group["id"]}/betaTesters?limit=200"
    )
    UI.user_error!("Tester lookup failed (#{testers_code})") unless (200..299).include?(testers_code)
    tester_emails = (testers_body["data"] || []).map { |tester| tester.dig("attributes", "email")&.downcase }
    [
      "nikitaaggarwal777@gmail.com",
      "vaageesha.das@gmail.com",
      "itsme@krithikrao.com",
      "dark.luck4777@krithikrao.com",
    ].each do |email|
      UI.user_error!("#{email} is missing from External Testers") unless tester_emails.include?(email.downcase)
      UI.success("#{email} is in External Testers")
    end
  end

  desc "List external TestFlight groups and their tester memberships."
  lane :tf_groups_status do
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], filepath: ENV["ASC_KEY_PATH"]
    )
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.user_error!("App #{APP_ID} not found") unless app
    code, body = asc_raw(
      :get,
      "v1/betaGroups?include=app%2CbetaTesters%2Cbuilds&limit=200&limit%5BbetaTesters%5D=50&limit%5Bbuilds%5D=50"
    )
    UI.user_error!("Group lookup failed (#{code}): #{body.inspect}") unless (200..299).include?(code)
    testers_by_id = (body["included"] || []).filter_map do |resource|
      next unless resource["type"] == "betaTesters"
      [resource["id"], resource.dig("attributes", "email")]
    end.to_h
    builds_by_id = (body["included"] || []).filter_map do |resource|
      next unless resource["type"] == "builds"
      [resource["id"], resource.dig("attributes", "version")]
    end.to_h
    groups = (body["data"] || []).select do |group|
      group.dig("relationships", "app", "data", "id") == app.id &&
        !group.dig("attributes", "isInternalGroup")
    end
    groups.each do |group|
      emails = (group.dig("relationships", "betaTesters", "data") || [])
        .filter_map { |tester| testers_by_id[tester["id"]] }
        .sort
      builds = (group.dig("relationships", "builds", "data") || [])
        .filter_map { |build| builds_by_id[build["id"]] }
        .sort
      UI.message("group=#{group["id"]} name=#{group.dig("attributes", "name").inspect} builds=#{builds.inspect} testers=#{emails.inspect}")
    end
  end

  desc "Did a build actually reach testers? Set TF_BUILD_NUMBER."
  # "Uploaded" and "delivered" are different states, and the gap between them
  # is silent: a build can be VALID, in the external group, and still reach
  # nobody because it was never approved for beta review. This reports the
  # whole chain so a release can be verified rather than assumed.
  lane :tf_delivery_status do
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], filepath: ENV["ASC_KEY_PATH"]
    )
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.user_error!("App #{APP_ID} not found") unless app
    build_number = ENV["TF_BUILD_NUMBER"] || UI.user_error!("Set TF_BUILD_NUMBER")
    build = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 20)
      .find { |candidate| candidate.version == build_number }
    UI.user_error!("Build #{build_number} not found") unless build

    _, detail = asc_raw(:get, "v1/builds/#{build.id}?include=betaAppReviewSubmission%2CbuildBetaDetail")
    included = detail["included"] || []
    submission = included.find { |item| item["type"] == "betaAppReviewSubmissions" }
    beta_detail = included.find { |item| item["type"] == "buildBetaDetails" }
    UI.message("processing=#{build.processing_state}")
    UI.message("internal=#{beta_detail&.dig("attributes", "internalBuildState") || "unknown"}")
    UI.message("external=#{beta_detail&.dig("attributes", "externalBuildState") || "unknown"}")
    UI.message("betaReview=#{submission&.dig("attributes", "betaReviewState") || "none submitted"}")

    _, review_details = asc_raw(:get, "v1/betaAppReviewDetails?filter%5Bapp%5D=#{app.id}&limit=1")
    contact = (review_details["data"] || []).first
    UI.message("reviewContactPhone=#{contact&.dig("attributes", "contactPhone").inspect}")

    _, groups = asc_raw(:get, "v1/builds/#{build.id}/betaGroups?limit=50")
    (groups["data"] || []).each do |group|
      UI.message("inGroup=#{group.dig("attributes", "name").inspect} internal=#{group.dig("attributes", "isInternalGroup")}")
    end
  end

  desc "Attach a build to the External Testers group. Set TF_BUILD_NUMBER."
  # An external group does NOT inherit new builds the way the internal one does
  # (it is created with hasAccessToAllBuilds: false, because every external
  # build needs Apple's beta review). So each release has to attach the build
  # here explicitly and then run submit_beta_review — miss this and the upload
  # is VALID, internal testers get it, and every external tester silently stays
  # on the previous build with nothing anywhere saying so.
  lane :tf_external do
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], filepath: ENV["ASC_KEY_PATH"]
    )
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.user_error!("App #{APP_ID} not found") unless app
    build_number = ENV["TF_BUILD_NUMBER"] || UI.user_error!("Set TF_BUILD_NUMBER")
    build = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 20)
      .find { |candidate| candidate.version == build_number }
    UI.user_error!("Build #{build_number} not found") unless build
    UI.user_error!("Build #{build_number} is #{build.processing_state}, not VALID") unless
      build.processing_state == "VALID"

    code, body = asc_raw(
      :get,
      "v1/betaGroups?include=app%2CbetaTesters%2Cbuilds&limit=200&limit%5BbetaTesters%5D=50&limit%5Bbuilds%5D=50"
    )
    UI.user_error!("Group lookup failed (#{code}): #{body.inspect}") unless (200..299).include?(code)
    candidates = (body["data"] || []).select do |group|
      group.dig("relationships", "app", "data", "id") == app.id &&
        !group.dig("attributes", "isInternalGroup")
    end
    # Several same-named groups have existed here. Pick the one people are
    # actually in, not the first match — attaching to an empty twin reaches
    # nobody and still reports success.
    target = candidates.max_by { |group| (group.dig("relationships", "betaTesters", "data") || []).size }
    UI.user_error!("No external group found") unless target
    testers = (target.dig("relationships", "betaTesters", "data") || []).size
    UI.user_error!("External group #{target["id"]} has no testers") if testers.zero?

    attach_code, attach_body = asc_raw(
      :post,
      "v1/betaGroups/#{target["id"]}/relationships/builds",
      { data: [{ type: "builds", id: build.id }] }
    )
    unless (200..299).include?(attach_code) || attach_code == 409
      UI.user_error!("Attach build failed (#{attach_code}): #{attach_body.inspect}")
    end

    _, verify = asc_raw(:get, "v1/betaGroups/#{target["id"]}/builds?limit=50")
    attached = (verify["data"] || []).map { |item| item.dig("attributes", "version") }
    UI.user_error!("Build #{build_number} still not in the group") unless attached.include?(build_number)
    UI.success("Build #{build_number} attached to '#{target.dig("attributes", "name")}' (#{testers} testers)")
    UI.important("Not live to them yet — run submit_beta_review and wait for Apple's approval.")
  end

  desc "Consolidate external testers into the group that owns the approved build."
  lane :tf_consolidate_external do
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], filepath: ENV["ASC_KEY_PATH"]
    )
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.user_error!("App #{APP_ID} not found") unless app
    build_number = ENV["TF_BUILD_NUMBER"] || "11"
    build = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 20)
      .find { |candidate| candidate.version == build_number }
    UI.user_error!("Build #{build_number} not found") unless build

    code, body = asc_raw(
      :get,
      "v1/betaGroups?include=app%2CbetaTesters%2Cbuilds&limit=200&limit%5BbetaTesters%5D=50&limit%5Bbuilds%5D=50"
    )
    UI.user_error!("Group lookup failed (#{code}): #{body.inspect}") unless (200..299).include?(code)
    groups = (body["data"] || []).select do |group|
      group.dig("relationships", "app", "data", "id") == app.id &&
        !group.dig("attributes", "isInternalGroup") &&
        group.dig("attributes", "name") == "External Testers"
    end
    target = groups.find do |group|
      (group.dig("relationships", "builds", "data") || []).any? { |item| item["id"] == build.id }
    end
    UI.user_error!("No External Testers group owns build #{build_number}") unless target

    desired_emails = [
      "nikitaaggarwal777@gmail.com",
      "vaageesha.das@gmail.com",
      "itsme@krithikrao.com",
      "dark.luck4777@krithikrao.com",
    ]
    testers_by_email = (body["included"] || []).filter_map do |resource|
      next unless resource["type"] == "betaTesters"
      email = resource.dig("attributes", "email")&.downcase
      [email, resource] if email
    end.to_h
    missing_resources = desired_emails.filter_map do |email|
      resource = testers_by_email[email]
      UI.user_error!("Tester #{email} was not found") unless resource
      next if (target.dig("relationships", "betaTesters", "data") || []).any? { |item| item["id"] == resource["id"] }
      { type: "betaTesters", id: resource["id"] }
    end
    unless missing_resources.empty?
      add_code, add_body = asc_raw(
        :post,
        "v1/betaGroups/#{target["id"]}/relationships/betaTesters",
        { data: missing_resources }
      )
      UI.user_error!("Add testers to build-backed group failed (#{add_code}): #{add_body.inspect}") unless (200..299).include?(add_code)
    end

    verify_code, verify_body = asc_raw(:get, "v1/betaGroups/#{target["id"]}/betaTesters?limit=200")
    UI.user_error!("Tester verification failed (#{verify_code}): #{verify_body.inspect}") unless (200..299).include?(verify_code)
    verified_emails = (verify_body["data"] || []).map { |tester| tester.dig("attributes", "email")&.downcase }
    desired_emails.each do |email|
      UI.user_error!("#{email} is missing from the build-backed group") unless verified_emails.include?(email)
      UI.success("#{email} has access to TestFlight build #{build_number}")
    end

    groups.each do |group|
      next if group["id"] == target["id"]
      next unless (group.dig("relationships", "builds", "data") || []).empty?
      delete_code, delete_body = asc_raw(:delete, "v1/betaGroups/#{group["id"]}")
      UI.user_error!("Delete redundant group #{group["id"]} failed (#{delete_code}): #{delete_body.inspect}") unless (200..299).include?(delete_code)
      UI.success("Removed redundant empty-build TestFlight group #{group["id"]}")
    end
  end

  desc "Report the latest build's processing state; clear export compliance when possible."
  lane :tf_status do
    require "spaceship"
    token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], filepath: ENV["ASC_KEY_PATH"]
    )
    Spaceship::ConnectAPI.token = token
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.user_error!("App #{APP_ID} not found") unless app
    UI.message("App: #{app.name} (#{app.id})")
    build = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-version", limit: 1).first
    if build
      UI.success("Latest build #{build.app_version} (#{build.version}) state=#{build.processing_state}")
      begin
        build.update(attributes: { usesNonExemptEncryption: false })
        UI.success("Export compliance cleared")
      rescue => e
        UI.message("Compliance note: #{e.message}")
      end
    else
      UI.important("No build on App Store Connect yet")
    end
  end
end
